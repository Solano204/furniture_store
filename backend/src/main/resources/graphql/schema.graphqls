# Exact-precision decimal for money fields - see BigDecimalScalar.java. Not
# graphql-java's built-in Float: that round-trips through a binary double and
# can silently lose precision on money values.
scalar BigDecimal

# Query type - queries related to fetching data
type Query {
    getFavorites(clerkId: String!): [Favorite]
    getFavorite(productId: String!, clerkId: String!): Favorite
    getUserOrders(clerkId: String!): [Order]
    getFeaturedProducts: [Product]
    getProductById(productId: String!): Product
    searchProducts(company: String!, name: String!): [Product]
    getProductReviews(productId: String!): [Review]
    getReviewAggregate(productId: String!): ReviewAggregate
    getReviewUserProduct(productId: String!, clerkId: String!): Boolean
    getUserReviews(clerkId: String!): [Review]
    getOrders: [Order]
    getInfoUser(username: String!): User
}

# Mutation type - mutations related to creating, updating, or deleting data always the name of the methon in lowerCase
type Mutation {
    addFavorite(input: AddFavoriteInput!): Favorite
    deleteFavorite(favoriteId: String!): Boolean
    createOrder(input: CreateOrderInput!): Order
    createProduct(input: CreateProductInput!): Product
    updateProduct(productId: String!, input: UpdateProductInput!): Product
    updateProductImage(productId: String!, image: String!): Product
    deleteProduct(productId: String!): Product
    createReview(input: CreateReviewInput!): Review
    deleteReview(id: String!, clerkId: String!): Boolean
    register(input: RegisterRequest!): AuthenticationResponse!
    authenticate(input: AuthenticationRequest!): AuthenticationResponse!
    # Returns the new access token, or null if the refresh token is invalid/expired.
    refreshToken(refreshToken: String!): String
    changePassword(input: ChangePasswordRequest!): String!
    logout: String
}

# Input types - input types used for mutations
input AddFavoriteInput {
    productId: String!
    clerkId: String!
}

input CreateProductInput {
    name: String!
    description: String!
    image: String!
    clerkId: String!
    company: String!
    price: Int!  
}


input UpdateProductInput {
    name: String
    description: String
    company: String
    price: Int
}

input CreateReviewInput {
    productId: String!
    authorName: String
    authorImageUrl: String
    rating: Int!
    comment: String
    clerkId: String!
}

input CreateOrderInput {
    clerkId: String!
    products: Int
    orderTotal: BigDecimal!
    tax: BigDecimal!
    shipping: BigDecimal!
    username: String!
}

# Type definitions - the data that will be returned by queries and mutations
type Product {
    id: String!
    name: String!
    description: String!
    company: String!
    image: String!
    clerkId: String!
    featured: Boolean
    createdAt: String!
    price: Int!
}

type Favorite {
    id: String!
    productId: String!
    clerkId: String!
    product: Product!

}

type Review {
    id: String!
    productId: String!
    rating: Float!
    authorName: String
    authorImageUrl: String
    comment: String
    clerkId: String!
    createdAt: String!
    updatedAt: String
    product: Product
}

type ReviewAggregate {
    productId: String!
    avgRating: Float!
    ratingCount: Int!
}

type Order {
    id: String!
    clerkId: String!
    products: Int
    orderTotal: BigDecimal!
    tax: BigDecimal!
    shipping: BigDecimal!
    username: String!
    createdAt: String!
}

# role is deliberately not client-settable here - self-registration always
# creates a plain USER account (see AuthenticationService#register); granting
# ADMIN/MODERATOR happens out of band, never from client input.
input RegisterRequest {
  username: String!
  password: String!
}

input AuthenticationRequest {
  username: String!
  password: String!
}

input ChangePasswordRequest {
  username: String!
  currentPassword: String!
  newPassword: String!
  confirmationPassword: String!
}

type AuthenticationResponse {
  accessToken: String!
  refreshToken: String!
  clerkId: String!
}

# Deliberately excludes the password hash - UserController#user only ever
# returns this over the wire, never the User entity directly.
type User {
  id: String!
  firstname: String
  lastname: String
  username: String!
}