# Copy to .env (or export directly) and fill in real local values.
# No application.properties/.yml is committed to this repo on purpose - these
# are the environment variables it reads. .env itself must never be committed.

# MongoDB connection string (reactive driver)
MONGODB_URI=mongodb://localhost:27017/furniture_store

# JWT signing key - must be a Base64-encoded string that decodes to at least
# 32 bytes (HS256 requires a >=256-bit key). Generate one with:
#   openssl rand -base64 48
JWT_SECRET_KEY=changeme

# Token lifetimes in milliseconds (defaults: 24h access / 7d refresh)
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

SERVER_PORT=8080
