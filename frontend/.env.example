# Copy to .env.local and fill in real local values. Never commit .env*.

# Backend GraphQL endpoint (see ../backend)
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8080/graphql

# Postgres, used by Prisma for cart/cart-item persistence (app/utils/cartActionPrisma.tsx
# is the active cart implementation - see prisma/schema.prisma).
DATABASE_URL=postgresql://user:password@localhost:5432/furniture_store
DIRECT_URL=postgresql://user:password@localhost:5432/furniture_store

# Supabase Storage, used for product image uploads (app/utils/supebase.ts)
SUPABASE_URL=changeme
SUPABASE_KEY=changeme

# Clerk user ID that's treated as the admin (see middleware.ts) - crude but
# that's the extent of the current authorization model, there's no roles table.
ADMIN_USER_ID=changeme

# Session cookie encryption key (app/utils/Api/Actions/cookies-session.tsx)
SECRET=changeme

# Clerk (used for its React components/user management even though session
# validation itself goes through the custom cookie system in middleware.ts)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=changeme
CLERK_SECRET_KEY=changeme
