# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions


# testinggit commit --amend -m "New commit message"

/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# docker-compose secrets (Doc 2) - local dev values, never real credentials
secrets/

# vercel
.vercel

# typescript
*.tsbuildinfo
# next-env.d.ts is deliberately tracked, not ignored here (see the file
# itself) - CI's tsc --noEmit step runs before next build would ever
# regenerate it, so a fresh checkout needs it to already exist.
